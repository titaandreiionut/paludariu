<?xml version="1.0" encoding="utf-8"?>
<!-- Widgetul de pe ecranul telefonului (Inel + Sticla): confortul in inel, temperatura si umiditatea,
     linia temperaturii pe 24 de ore si 4 butoane pentru pompa, lumina, ceata si ventilator. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="11dp"
    android:paddingRight="14dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/logo_header" />

        <TextView
            android:id="@+id/w_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Paludariu"
            android:textColor="#FFE8F1E7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textColor="#FF93A99A"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <ImageView
                android:id="@+id/w_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_sc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="--"
                    android:textColor="#FFE8F1E7"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="CONFORT"
                    android:textColor="#FF93A99A"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/w_t"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:text="--"
                        android:textColor="#FFF2B45A"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="temperatură"
                        android:textColor="#FF93A99A"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/w_h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#FF5CC6C0"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="umiditate"
                        android:textColor="#FF93A99A"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_spark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="24 h"
                    android:textColor="#FF93A99A"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_b0"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ob_off"
                    android:contentDescription="Pompă"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_pompa" />

                <ImageView
                    android:id="@+id/w_b1"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ob_off"
                    android:contentDescription="Lumină"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_lumina" />

                <ImageView
                    android:id="@+id/w_b2"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ob_off"
                    android:contentDescription="Ceață"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_ceata" />

                <ImageView
                    android:id="@+id/w_b3"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ob_off"
                    android:contentDescription="Ventilator"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_vent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
